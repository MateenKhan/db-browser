# Copy to .env. Credentials and file paths are read here and nowhere else —
# they are never sent to the browser, logged, or echoed in an API response.

# --- Source 1: relational Postgres (optional) -------------------------------
# Omit to run the demo with only the SQLite sources.
DATABASE_URL=postgresql://platform:platform@localhost:5434/platformdb

# --- Source 2: a SQLite embedding store (optional) --------------------------
# Any database with chunk + embedding + build_meta is detected as a vector
# store and rendered with the semantic-search UI instead of a grid.
# Always opened read-only: an index is derived data.
EMBEDDINGS_DB=./data/code-embeddings.db

# --- Source 3: a code-review-graph database (optional) ----------------------
CODE_GRAPH_DB=./data/graph.db

# --- Semantic search + rebuild (optional) -----------------------------------
# Where POST /embeddings/search, POST /embeddings/rebuild and
# GET /embeddings/rebuild/:id live. The demo server proxies to it under
# /api/index. Leave it unset and the store is still fully browsable — only the
# search box and the rebuild button report themselves unavailable.
PIRANHA_API_URL=http://localhost:6952

# Port for the demo API + static server.
PORT=6960

# Writes are OFF unless this is exactly "true", and it only ever applies to the
# Postgres source. Read-only is enforced twice: by the statement guard, and by
# the engine itself (a `BEGIN ... READ ONLY` transaction on Postgres, a
# driver-level read-only open on SQLite).
DB_BROWSER_ALLOW_WRITES=false

# Origins allowed to call the API (the Vite dev server, by default).
DB_BROWSER_ORIGINS=http://localhost:5173

# Per-statement timeout (Postgres only — SQLite runs in-process).
DB_BROWSER_TIMEOUT_MS=15000

# Use the demo's local stand-in index service (apps/demo/server/index-service.ts)
# instead of proxying to PIRANHA_API_URL. Search is real (it embeds the query
# with the same Ollama model the index was built with and scores it against the
# stored vectors); rebuild is a DRY RUN that reports genuine progress and writes
# nothing. Off by default — the real service is always the better answer.
DEMO_INDEX_SERVICE=false

# --- Connections you add through the UI --------------------------------------
# Where the server-owned connection store lives. Passwords in it are AES-256-GCM
# ciphertext under a 0600 key file created beside it. Nothing here is ever sent
# to the browser: a read reports only *whether* a secret is set.
# DB_BROWSER_STATE_DIR=./.db-browser

# Which address to bind. Loopback by default, and that default is load-bearing:
# connection editing and connector installs are enabled ONLY on a loopback
# binding. Setting 0.0.0.0 to reach the demo from another machine turns those
# two off with an explanation rather than leaving an SSRF and credential-
# harvesting surface open to whoever can reach the port. Browsing is unaffected.
# HOST=127.0.0.1

# Turn connection editing off even on loopback (read-only deployment).
# DB_BROWSER_DISABLE_EDITING=false

# Override the encryption key instead of writing one to disk (containers).
# 32 bytes, base64.
# DB_BROWSER_SECRET_KEY=
