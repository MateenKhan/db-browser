# Copy to .env. The server reads credentials from here and nowhere else —
# they are never sent to the browser, logged, or echoed in an API response.
DATABASE_URL=postgresql://platform:platform@localhost:5434/platformdb

# Port for the demo API + static server.
PORT=6960

# Writes are OFF unless this is exactly "true". Read-only is enforced twice:
# by the statement guard, and by running every statement in a
# `BEGIN ... READ ONLY` transaction.
DB_BROWSER_ALLOW_WRITES=false

# Origins allowed to call the API (the Vite dev server, by default).
DB_BROWSER_ORIGINS=http://localhost:5173

# Per-statement timeout.
DB_BROWSER_TIMEOUT_MS=15000
