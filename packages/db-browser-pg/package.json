{
  "name": "@jugaaadi/db-browser-pg",
  "version": "0.0.1",
  "description": "Reference Postgres DataSource + HTTP server for @jugaaadi/db-browser. Node only.",
  "license": "MIT",
  "author": "Mateen Khan",
  "type": "module",
  "main": "./dist/index.js",
